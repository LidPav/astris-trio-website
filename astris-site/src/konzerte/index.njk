---
layout: layout.njk
title: Konzerte
description: Termine und Konzertarchiv
---

<h1 class="h1">Konzerte</h1>

{% set items = collections.konzerte | sort('date') %}

<section class="concert-section">
  <h2 class="h2">Termine</h2>

  <div class="list">
    {% set hasUpcoming = false %}

    {% for post in items %}
      {% if post.date >= page.date %}
        {% set hasUpcoming = true %}

        <div class="card">
          <h2 class="h2">
            <a href="{{ post.url | url }}">{{ post.data.title }}</a>
          </h2>

          <p class="muted small">
            {{ post.date | deDate("EEEE, d. LLLL yyyy") }}
            {% if post.data.city %} · {{ post.data.city }}{% endif %}
            {% if post.data.venue %} · {{ post.data.venue }}{% endif %}
          </p>

          <a class="btn" href="{{ post.url | url }}">Details</a>
        </div>
      {% endif %}
    {% endfor %}

    {% if not hasUpcoming %}
      <p class="muted">Derzeit sind keine weiteren Konzerte angekündigt.</p>
    {% endif %}
  </div>
</section>

<section class="concert-section concert-section--archive">
  <h2 class="h2">Archiv</h2>

  <div class="list">
    {% set archiveItems = items | reverse %}

    {% for post in archiveItems %}
      {% if post.date < page.date %}
        <div class="card">
          <h2 class="h2">
            <a href="{{ post.url | url }}">{{ post.data.title }}</a>
          </h2>

          <p class="muted small">
            {{ post.date | deDate("EEEE, d. LLLL yyyy") }}
            {% if post.data.city %} · {{ post.data.city }}{% endif %}
            {% if post.data.venue %} · {{ post.data.venue }}{% endif %}
          </p>

          <a class="btn" href="{{ post.url | url }}">Details</a>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>
